#!/bin/bash

if ! flatpak info org.vanillaos.ApxGUI &>/dev/null; then
    echo "Looks like Apx is missing from your system. Do you want to install it now? [y/N]"
    read -r answer
    if [ "$answer" != "y" ] || ! flatpak install -y org.vanillaos.ApxGUI; then
        exit 1
    fi
fi

exec flatpak run --command=apx org.vanillaos.ApxGUI "$@"
